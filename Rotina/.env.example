# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variáveis necessárias para o agente gsheet-rotina
#
# INSTRUÇÃO: Copie este arquivo como ".env", preencha os valores reais
# e NUNCA commite o arquivo ".env".
#
# O arquivo ".env" já está no .gitignore desta pasta.
# ─────────────────────────────────────────────────────────────────────────────

# ── Habitica ─────────────────────────────────────────────────────────────────
# Onde obter: habitica.com → Configurações do usuário → API
HABITICA_USER_ID=seu-user-id-aqui
HABITICA_API_TOKEN=seu-api-token-aqui

# ── Toggl Track ──────────────────────────────────────────────────────────────
# Onde obter: track.toggl.com → Perfil → Profile Settings → API Token
TOGGL_API_TOKEN=seu-api-token-aqui

# ── Google Sheets ────────────────────────────────────────────────────────────
# GOOGLE_SHEET_ID: extraído da URL da planilha
# URL exemplo: https://docs.google.com/spreadsheets/d/ESTE_É_O_ID/edit
GOOGLE_SHEET_ID=id-da-planilha-aqui

# GOOGLE_SERVICE_ACCOUNT_JSON: caminho ABSOLUTO para o arquivo JSON da service account
# IMPORTANTE: salve o JSON FORA da pasta do projeto (ex.: C:\Users\seu-usuario\.credentials\)
# Nunca coloque o arquivo JSON dentro desta pasta.
GOOGLE_SERVICE_ACCOUNT_JSON=C:\Users\seu-usuario\.credentials\gsheet-rotina-sa.json
