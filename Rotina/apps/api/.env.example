# apps/api/.env.example
# Copie para .env e preencha os valores

# ── Banco de dados ────────────────────────────────────────
# SQLite (desenvolvimento local offline)
DATABASE_URL="file:./dev.db"

# PostgreSQL (produção) — descomente se usar
# DATABASE_URL="postgresql://user:password@localhost:5432/rotina_db"

# ── Servidor ──────────────────────────────────────────────
PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Habitica ──────────────────────────────────────────────
# Obtenha em: https://habitica.com/user/settings/api
HABITICA_USER_ID=
HABITICA_API_TOKEN=
HABITICA_API_URL=https://habitica.com/api/v3

# ── Toggl ─────────────────────────────────────────────────
# Obtenha em: https://track.toggl.com/profile
TOGGL_API_TOKEN=
TOGGL_WORKSPACE_ID=
TOGGL_API_URL=https://api.track.toggl.com/api/v9

# ── Google Sheets ─────────────────────────────────────────
SHEETS_SPREADSHEET_ID=1zkp7RJwye527VPkZd_bG6OCDI0xgwF6m60YJei0IUsg
SHEETS_CLIENT_EMAIL=
SHEETS_PRIVATE_KEY=
